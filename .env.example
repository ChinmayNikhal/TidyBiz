# TidyBiz backend environment configuration (example — placeholders only).
# Copy to .env and adjust locally. NEVER commit a real .env file or real credentials.

# Application
TIDYBIZ_DEBUG=false

# Database — SQLAlchemy URL.
#
# Local development default (file-based SQLite; local only, not for deployment):
TIDYBIZ_DATABASE_URL=sqlite:///./tidybiz.db
#
# Local Dockerized PostgreSQL (docker compose up db):
# TIDYBIZ_DATABASE_URL=postgresql+psycopg://tidybiz:tidybiz-dev-only@localhost:5432/tidybiz
#
# Supabase PostgreSQL (hosted) — read host/credentials from your Supabase project
# settings; do not guess hostnames and never commit the password or service-role key.
# Direct connection (migrations / admin):
# TIDYBIZ_DATABASE_URL=postgresql+psycopg://<user>:<password>@db.<project-ref>.supabase.co:5432/<database>?sslmode=require
# Session pooler (long-lived app connections when IPv4 is required):
# TIDYBIZ_DATABASE_URL=postgresql+psycopg://<user>:<password>@<pooler-host>:5432/<database>?sslmode=require
#
# See Architecture.md §14 for connection-mode guidance (direct vs session pooler,
# SSL, pooling) and README "Database" section for local setup.

# CORS — comma-separated browser origins allowed in local development.
# Not needed when the same process serves the frontend; set the static host's
# origin here once frontend hosting is chosen.
TIDYBIZ_CORS_ORIGINS=http://localhost:5173

# Port binding — the backend host supplies PORT; local fallback:
TIDYBIZ_PORT=8000

# Seed the idempotent demo workspace on startup (true for local/dev/demo).
TIDYBIZ_SEED_ON_STARTUP=true
